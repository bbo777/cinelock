{
  "schema_version": "2.0",
  "notes": "平台无关能力矩阵。modes 只使用 text2video / img2video / multi_ref / first_last；img2video 固定单张首帧，first_last 固定首尾两张。adapter 决定执行方式：mock / handoff / comfyui / http_api。修改本文件会改变 context revision。",
  "providers": {
    "mock": {
      "display_name": "Mock（本地占位视频）",
      "adapter": "mock",
      "enabled": true,
      "modes": [
        "text2video",
        "img2video",
        "multi_ref",
        "first_last"
      ],
      "max_refs": 10,
      "durations": [
        3,
        4,
        5,
        6,
        8,
        10
      ],
      "supports_negative_prompt": true,
      "supports_seed": true,
      "ref_semantics": "ordered_multi_reference",
      "prompt_suffix": "consistent character identity, stable face, natural motion, no character drift",
      "notes": "纯本地：Pillow 绘制占位底板，ffmpeg 编码 mp4。不联网、不需要 Node、不消耗任何额度。"
    },
    "handoff": {
      "display_name": "Handoff（手工交接包）",
      "adapter": "handoff",
      "enabled": true,
      "modes": [
        "text2video",
        "img2video",
        "multi_ref",
        "first_last"
      ],
      "max_refs": 10,
      "durations": [
        3,
        4,
        5,
        6,
        8,
        10
      ],
      "supports_negative_prompt": true,
      "supports_seed": true,
      "ref_semantics": "ordered_multi_reference",
      "prompt_suffix": "consistent character identity, stable face, natural motion, no character drift",
      "notes": "导出 prompt.txt / negative.txt / refs/ / manifest.json / README.md，可上传到 Midjourney、可灵、即梦或任何支持多参考图的平台。"
    },
    "comfyui": {
      "display_name": "ComfyUI（本地/远程工作流）",
      "adapter": "comfyui",
      "enabled": true,
      "experimental": true,
      "modes": [
        "text2video",
        "img2video",
        "multi_ref",
        "first_last"
      ],
      "max_refs": 10,
      "durations": [
        3,
        4,
        5,
        6,
        8,
        10
      ],
      "supports_negative_prompt": true,
      "supports_seed": true,
      "ref_semantics": "ordered_multi_reference",
      "prompt_suffix": "consistent character identity, stable face, natural motion, no character drift",
      "base_url": "http://127.0.0.1:8188",
      "workflow": "config/comfyui/workflow.example.json",
      "timeout_sec": 600,
      "poll_interval_sec": 2,
      "notes": "通过 ComfyUI HTTP API 上传参考图、提交工作流、轮询 /history 并下载产物。示例工作流是占位骨架，请换成你已安装节点的工作流。"
    },
    "official_kling": {
      "display_name": "可灵官方 API（实验）",
      "adapter": "http_api",
      "preset": "kling",
      "enabled": true,
      "experimental": true,
      "modes": [
        "text2video",
        "img2video",
        "first_last"
      ],
      "max_refs": 2,
      "durations": [
        5,
        10
      ],
      "supports_negative_prompt": true,
      "supports_seed": false,
      "ref_semantics": "first_last_frames",
      "prompt_suffix": "preserve character identity, stable face, natural motion",
      "base_url": "https://api.klingai.com",
      "model": "kling-v1",
      "image_input": "base64",
      "access_key_env": "KLING_ACCESS_KEY",
      "secret_key_env": "KLING_SECRET_KEY",
      "timeout_sec": 900,
      "poll_interval_sec": 5,
      "notes": "官方 OpenAPI，使用 AccessKey/SecretKey 生成短期 JWT。端点和字段可能随官方文档变化；没有凭证时执行会明确失败，不会伪造成功。"
    },
    "official_runway": {
      "display_name": "Runway 官方 API（实验）",
      "adapter": "http_api",
      "preset": "runway",
      "enabled": true,
      "experimental": true,
      "modes": [
        "text2video",
        "img2video"
      ],
      "max_refs": 1,
      "durations": [
        5,
        10
      ],
      "supports_negative_prompt": false,
      "supports_seed": true,
      "ref_semantics": "first_frame",
      "prompt_suffix": "preserve character identity, stable face, natural motion",
      "base_url": "https://api.dev.runwayml.com",
      "model": "gen3a_turbo",
      "image_input": "data_uri",
      "api_key_env": "RUNWAY_API_KEY",
      "send_seed": true,
      "ratio_map": {
        "16:9": "1280:768",
        "9:16": "768:1280"
      },
      "timeout_sec": 900,
      "poll_interval_sec": 5,
      "notes": "官方 API，Bearer Token + X-Runway-Version。不同模型支持的模式/时长不同；没有 RUNWAY_API_KEY 时执行会明确失败。"
    }
  },
  "ui_order": [
    "mock",
    "handoff",
    "comfyui",
    "official_kling",
    "official_runway"
  ]
}
